{
  "name": "indexmenow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Panel do przyspieszania indeksowania stron w Google, Bing i Yandex",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"console.log('Build OK → dist/server.js')\"",
    "start": "node server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "main": "server.js",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nunjucks": "^3.2.6",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.10.1",
    "google-auth-library": "^11.0.0",
    "kysely": "^0.29.4",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nunjucks": "^3.2.4",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
