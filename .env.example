# ------------------------------------------------------------------
# IndexMeNow - konfiguracja
# Skopiuj ten plik jako `.env` i uzupelnij wartosci.
# ------------------------------------------------------------------

# --- Serwer -------------------------------------------------------
HOST=0.0.0.0
PORT=8006

# Publiczny adres panelu. MUSI zgadzac sie z Authorized redirect URI
# w Google Cloud Console (z doklejonym /auth/callback).
# Lokalnie:    http://192.168.1.50:8006
# Na Hostingerze: https://morphyhub.com
#
# Na publicznej domenie musi byc https. Google OAuth przyjmuje
# adresy http tylko dla localhost.
BASE_URL=http://192.168.1.50:8006

# Klucz sesji i szyfrowania tokenow. Wygeneruj wlasny:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=zmien-mnie-na-dlugi-losowy-ciag-znakow

# --- Google OAuth -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dostep ------------------------------------------------------
# Lista adresow e-mail (po przecinku), ktore moga sie zalogowac.
# Puste = kazdy z kontem Google moze zalozyc konto.
ALLOWED_EMAILS=
# Pierwszy zalogowany uzytkownik zawsze dostaje role administratora.

# --- Baza danych (MySQL) ------------------------------------------
# Preferowana forma: osobne zmienne (tak podaje je Hostinger).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=indexmenow

# Alternatywnie jeden URL (nadpisuje pola powyzej):
# DATABASE_URL=mysql://user:pass@localhost:3306/indexmenow

# --- Indeksowanie -------------------------------------------------
DEFAULT_DAILY_QUOTA=200
SITEMAP_SCAN_INTERVAL_HOURS=12
AUTO_INDEX_HOUR=3
INSPECTION_BATCH_SIZE=50
API_THROTTLE_SECONDS=0.6
RECHECK_AFTER_DAYS=7

# Na zarzadzanym hostingu (Hostinger Web App) trzymamy scheduler
# wlaczony, ale blokada w MySQL pilnuje, zeby tylko jedna instancja
# wykonywala zadania cykliczne. Ustaw false, jesli chcesz zglaszac
# tylko recznie z panelu.
SCHEDULER_ENABLED=true

# --- Rozne --------------------------------------------------------
TIMEZONE=Europe/Warsaw
LOG_LEVEL=INFO
DEBUG=false
