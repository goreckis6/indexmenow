# ------------------------------------------------------------------
# IndexMePlease - konfiguracja
# Skopiuj ten plik jako `.env` i uzupelnij wartosci.
# ------------------------------------------------------------------

# --- Serwer -------------------------------------------------------
# 0.0.0.0 = dostepne dla calej sieci domowej (np. http://192.168.1.50:8006)
HOST=0.0.0.0
PORT=8006

# Publiczny adres pod ktorym dziala panel. MUSI zgadzac sie z adresem
# wpisanym w Google Cloud Console jako "Authorized redirect URI"
# (z doklejonym /auth/callback).
BASE_URL=http://192.168.1.50:8006

# Klucz sesji i szyfrowania tokenow. Wygeneruj wlasny:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zmien-mnie-na-dlugi-losowy-ciag-znakow

# --- Google OAuth -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dostep ------------------------------------------------------
# Lista adresow e-mail (po przecinku), ktore moga sie zalogowac.
# Puste = kazdy z kontem Google moze zalozyc konto.
ALLOWED_EMAILS=
# Pierwszy zalogowany uzytkownik zawsze dostaje role administratora.

# --- Baza danych --------------------------------------------------
DATABASE_URL=sqlite:///./data/indexmeplease.db

# --- Indeksowanie -------------------------------------------------
# Domyslny dzienny limit zgloszen do Google Indexing API na projekt.
# Google przyznaje 200/dzien na projekt (mozna zwiekszyc kontami serwisowymi).
DEFAULT_DAILY_QUOTA=200
# Co ile godzin scheduler skanuje sitemapy w poszukiwaniu nowych URL-i
SITEMAP_SCAN_INTERVAL_HOURS=12
# Godzina (0-23) codziennego automatycznego indeksowania
AUTO_INDEX_HOUR=3
# Ile URL-i sprawdzac inspekcja w jednym przebiegu na strone
INSPECTION_BATCH_SIZE=50
# Odstep miedzy zapytaniami do API (sekundy) - ochrona przed rate limitem
API_THROTTLE_SECONDS=0.6
# Co ile dni ponawiac inspekcje juz sprawdzonego URL-a
RECHECK_AFTER_DAYS=7

# --- Rozne --------------------------------------------------------
TIMEZONE=Europe/Warsaw
LOG_LEVEL=INFO
DEBUG=false
