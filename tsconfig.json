{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    // Bez "type": "module" w package.json nodenext emituje CommonJS, a przy tym
    // nie wymaga rozszerzen .js w importach - stad ten wariant, a nie ESM.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
